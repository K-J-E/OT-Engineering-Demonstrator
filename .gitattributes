# Normalize repository text and force deterministic LF working-tree bytes.
* text=auto eol=lf

# Controlled hash-protected inputs and implementation text artefacts.
*.json text eol=lf
*.lock text eol=lf
*.sql text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Authoritative documents and other binary artefacts must never be text-normalized.
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.sqlite3 binary
*.db binary
